<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.veeva.vault.custom</groupId>
	<artifactId>${PROJECT_NAME}</artifactId>
	<version>1.0</version>
	<properties>
		<vault.sdk.version>[${SDKVersion}-build0, ${SDKVersion}-build1000000]</vault.sdk.version>
	</properties>
    <pluginRepositories>
		<pluginRepository>
			<id>vaultjavasdk-maven-plugin</id>
			<url>https://d1hn8xtm1m9t3p.cloudfront.net/vaultjavasdk-maven-plugin/maven</url>
			<releases>
				<enabled>true</enabled>
				<updatePolicy>always</updatePolicy>
			</releases>
		</pluginRepository>
	</pluginRepositories>
	<repositories>
		<repository>
			<id>nexus</id>
			<url>http://build2.vaultdev.com:8081/nexus/content/repositories/snapshots/</url>
			<snapshots>
			<enabled>true</enabled>
			<updatePolicy>always</updatePolicy>
			</snapshots>
		</repository>
	</repositories>
	<dependencies>
		<dependency>
			<groupId>com.veeva.vault.sdk.api</groupId>
			<artifactId>vault-sdk-api</artifactId>
			<version>${vault.sdk.version}</version>
		</dependency>
		<dependency>
			<groupId>com.veeva.vault.sdk.debugger</groupId>
			<artifactId>vault-sdk-debugger</artifactId>
			<version>${vault.sdk.version}</version>
		</dependency>
		<dependency>
			<groupId>com.veeva.vault.sdk.test</groupId>
			<artifactId>vault-sdk-test</artifactId>
			<version>${vault.sdk.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.12</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.10.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<version>1.1.0</version>
				<executions>
					<execution>
						<phase>initialize</phase>
						<goals>
							<goal>read-project-properties</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<files>
						<file>src/main/resources/vault.properties</file>
					</files>
					<outputFile/>
					<properties/>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.veeva.vault.sdk</groupId>
				<artifactId>vaultjavasdk-maven-plugin</artifactId>
				<version>22.2.0</version>
				<configuration>
					<vaultDNS>${vault.vaultDNS}</vaultDNS>
					<username>${vault.username}</username>
					<password>${vault.password}</password>
					<sessionId>${vault.sessionId}</sessionId>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>