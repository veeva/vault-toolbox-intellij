  <template name="sdk_querycount" value="QueryService queryService = ServiceLocator.locate(QueryService.class);&#10;Query query = queryService&#10;&#9;&#9;.newQueryBuilder()&#10;&#9;&#9;.withSelect(asList(&quot;id&quot;))&#10;&#9;&#9;.withFrom(&quot;documents&quot;)&#10;&#9;&#9;.build();&#10;&#10;QueryCountRequest queryCountRequest  = queryService&#10;&#9;&#9;.newQueryCountRequestBuilder()&#10;&#9;&#9;.withQuery(query)&#10;&#9;&#9;.build();&#10;&#10;queryService.count(queryCountRequest)&#10;&#9;&#9;.onSuccess(queryResponse -&gt; {})&#10;&#9;&#9;.onError(queryOperationError -&gt; {})&#10;&#9;&#9;.execute();" description="Query Builder - Count" toReformat="false" toShortenFQNames="true">
