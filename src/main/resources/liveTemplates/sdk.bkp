  <template name="sdk_doctype" value="DocumentMetadataService documentMetadataService = ServiceLocator.locate(DocumentMetadataService.class);&#10;DocumentTypeRequest documentTypeRequest = documentMetadataService.newDocumentTypeRequestBuilder()&#10;&#9;&#9;.withType(&quot;demo__c&quot;).build();&#10;DocumentType demoType = documentMetadataService.getDocumentType(documentTypeRequest);" description="Metadata" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JAVA_EXPRESSION" value="true" />
    </context>
  </template>
  <template name="sdk_docfields" value="DocumentMetadataService documentMetadataService = ServiceLocator.locate(DocumentMetadataService.class);&#10;DocumentTypeRequest documentTypeRequest = documentMetadataService.newDocumentTypeRequestBuilder()&#10;&#9;&#9;.withType(&quot;demo__c&quot;).build();&#10;DocumentType demoType = documentMetadataService.getDocumentType(documentTypeRequest);&#10;&#10;Set&lt;String&gt; fieldList = VaultCollections.newSet();&#10;fieldList.add(&quot;name__v&quot;);&#10;fieldList.add(&quot;title__v&quot;);&#10;&#10;DocumentFieldCollectionRequest collectionRequest = documentMetadataService&#10;&#9;&#9;.newDocumentFieldCollectionRequestBuilder()&#10;&#9;&#9;.withDocumentType(demoType)&#10;&#9;&#9;.withFieldNames(fieldList)&#10;&#9;&#9;.build();" description="Metadata" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JAVA_EXPRESSION" value="true" />
    </context>
  </template>
  <template name="sdk_querytokens" value="List&lt;String&gt; versionList = VaultCollections.newList();&#10;versionList.add(&quot;1_1_0&quot;);&#10;versionList.add(&quot;2_1_0&quot;);&#10;&#10;QueryService queryService = ServiceLocator.locate(QueryService.class);&#10;Query query = queryService&#10;&#9;&#9;.newQueryBuilder()&#10;&#9;&#9;.withSelect(asList(&quot;title__v&quot;))&#10;&#9;&#9;.withFrom(&quot;documents&quot;)&#10;&#9;&#9;.withWhere(&quot;version_id CONTAINS (${Custom.version_id})&quot;)&#10;&#9;&#9;.appendWhere(QueryLogicalOperator.AND,&#10;&#9;&#9;&#9;&#9;&quot;version_creation_date__v &gt; ${Custom.my_date}&quot;)&#10;&#9;&#9;.build();&#10;&#10;TokenService tokenService = ServiceLocator.locate(TokenService.class);&#10;TokenRequest tokenRequest = tokenService.newTokenRequestBuilder()&#10;&#9;&#9;.withValue(&quot;Custom.version_id&quot;, versionList)&#10;&#9;&#9;.withValue(&quot;Custom.my_date&quot;, LocalDate.now().minusDays(7))&#10;&#9;&#9;.build();&#10;&#10;QueryExecutionRequest queryRequest = queryService&#10;&#9;&#9;.newQueryExecutionRequestBuilder()&#10;&#9;&#9;.withQuery(query)&#10;&#9;&#9;.withTokenRequest(tokenRequest)&#10;&#9;&#9;.build();&#10;&#10;queryService.query(queryRequest)&#10;&#9;&#9;.onSuccess(queryResponse -&gt; {&#10;&#9;&#9;&#9;queryResponse.streamResults().forEach(queryExecutionResult -&gt; {&#10;&#9;&#9;&#9;&#9;&#9;&#9;String title = queryExecutionResult.getValue(&quot;title__v&quot;, ValueType.STRING);&#10;&#9;&#9;&#9;&#9;&#9;}&#10;&#9;&#9;&#9;);&#10;&#9;&#9;})&#10;&#9;&#9;.onError(queryOperationError -&gt; {&#10;&#9;&#9;&#9;LogService logger = ServiceLocator.locate(LogService.class);&#10;&#9;&#9;&#9;logger.debug(&quot;error!&quot;);&#10;&#9;&#9;})&#10;&#9;&#9;.execute();" description="Query Builder - Tokens" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JAVA_EXPRESSION" value="true" />
    </context>
  </template>
  <template name="sdk_doctypetriggerloop" value="for (DocumentVersionChange documentVersionChange : context.getDocumentVersionChanges()) {&#10;&#9;DocumentVersion documentVersion = documentVersionChange.getNew();&#10;}" description="Doctype Trigger Loop" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JAVA_EXPRESSION" value="true" />
    </context>
  </template>
</templateSet>