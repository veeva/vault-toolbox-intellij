<templateSet group="Vault Java SDK">
  <template name="sdk_recordlifecyclechange" value="String newLifecycle = objRecord.getNew().getValue(OBJFIELD_STATE, ValueType.STRING);&#10;String oldLifecycle = objRecord.getOld().getValue(OBJFIELD_STATE, ValueType.STRING);&#10;if ((!newLifecycle.equals(oldLifecycle)) &amp;&amp; (newLifecycle.equals(LC_STATE_VALUE))) {&#10;}" description="Compare Lifecycle" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JAVA_STATEMENT" value="true" />
    </context>
  </template>
  <template name="sdk_queryexecute" value="QueryService queryService = ServiceLocator.locate(QueryService.class);&#10;Query query = queryService&#10;&#9;&#9;.newQueryBuilder()&#10;&#9;&#9;.withSelect(asList(&quot;id&quot;))&#10;&#9;&#9;.withFrom(&quot;documents&quot;)&#10;&#9;&#9;.build();&#10;&#10;QueryExecutionRequest queryRequest = queryService&#10;&#9;&#9;.newQueryExecutionRequestBuilder()&#10;&#9;&#9;.withQuery(query)&#10;&#9;&#9;.build();&#10;&#10;queryService.query(queryRequest)&#10;&#9;&#9;.onSuccess(queryResponse -&gt; {})&#10;&#9;&#9;.onError(queryOperationError -&gt; {})&#10;&#9;&#9;.execute();" description="Query Builder - Execute" toReformat="false" toShortenFQNames="true">
