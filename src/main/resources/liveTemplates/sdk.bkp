  <template name="sdk_recordservice" value="RecordService recordService = ServiceLocator.locate(RecordService.class);&#10;Record record = recordService.newRecordWithId(&quot;simple__c&quot;, &quot;V4G000000004001&quot;);&#10;record.setValue(&quot;comment__c&quot;, &quot;SDK&quot;);&#10;&#10;RecordBatchSaveRequest recordBatchSaveRequest = recordService&#10;&#9;&#9;.newRecordBatchSaveRequestBuilder()&#10;&#9;&#9;.withRecords(asList(record))&#10;&#9;&#9;.build();&#10;recordService.batchSaveRecords(recordBatchSaveRequest)&#10;&#9;&#9;.onSuccesses(positionalRecordIds -&gt; {&#10;&#10;&#9;&#9;})&#10;&#9;&#9;.rollbackOnErrors()&#10;&#9;&#9;.execute();" description="RecordService" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JAVA_EXPRESSION" value="true" />
    </context>
  </template>
  <template name="sdk_documentservice" value="DocumentService documentService = ServiceLocator.locate(DocumentService.class);&#10;DocumentVersion documentVersion = documentService.newVersionWithId(&quot;5_0_1&quot;);&#10;//String docID = documentVersion.getValue(&quot;id&quot;, ValueType.STRING);&#10;//documentVersion.setValue(&quot;name__v&quot;, &quot;SDK&quot;);&#10;documentService.saveDocumentVersions(asList(documentVersion));" description="DocumentService" toReformat="false" toShortenFQNames="true">
