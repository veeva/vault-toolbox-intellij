  <template name="sdk_querylegacy" value="QueryService queryService = ServiceLocator.locate(QueryService.class);&#10;queryService.query(&quot;select id from user__sys&quot;).streamResults().forEach(&#10;&#9;&#9;queryResult -&gt; {&#10;&#9;&#9;&#9;String name = queryResult.getValue(&quot;name__v&quot;, ValueType.STRING);&#10;&#9;&#9;}&#10;);" description="Query Legacy" toReformat="false" toShortenFQNames="true">
