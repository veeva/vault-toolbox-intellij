  <template name="sdk_docfield" value="DocumentMetadataService documentMetadataService = ServiceLocator.locate(DocumentMetadataService.class);&#10;DocumentField nameField = documentMetadataService.getField(&quot;name__v&quot;);" description="Metadata" toReformat="false" toShortenFQNames="true">
