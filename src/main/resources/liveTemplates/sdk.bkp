  <template name="sdk_queryvalidate" value="QueryService queryService = ServiceLocator.locate(QueryService.class);&#10;Query query = queryService&#10;&#9;&#9;.newQueryBuilder()&#10;&#9;&#9;.withSelect(asList(&quot;id&quot;))&#10;&#9;&#9;.withFrom(&quot;documents&quot;)&#10;&#9;&#9;.build();&#10;&#10;QueryValidationRequest queryRequest  = queryService&#10;&#9;&#9;.newQueryValidationRequestBuilder()&#10;&#9;&#9;.withQuery(query)&#10;&#9;&#9;.build();&#10;&#10;queryService.validate(queryRequest)&#10;&#9;&#9;.onSuccess(queryResponse -&gt; {})&#10;&#9;&#9;.onError(queryOperationError -&gt; {})&#10;&#9;&#9;.execute();" description="Query Builder - Validate" toReformat="false" toShortenFQNames="true">
