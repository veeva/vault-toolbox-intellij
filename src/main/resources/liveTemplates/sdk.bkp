    </context>
  </template>
  <template name="sdk_http" value="LogService logger = ServiceLocator.locate(LogService.class);&#10;HttpService httpService = ServiceLocator.locate(HttpService.class);&#10;HttpRequest httpRequest = httpService.newHttpRequest(&quot;local&quot;)&#10;&#9;&#9;.setMethod(HttpMethod.GET)&#10;&#9;&#9;.appendPath(&quot;api/v22.1/objects/users/me&quot;)&#10;&#9;&#9;.setResolveTokens(true);&#10;&#10;httpService.send(httpRequest, HttpResponseBodyValueType.STRING)&#10;&#9;&#9;.onError(response -&gt; {&#10;&#9;&#9;&#9;String errorMessage = &quot;HTTP Status Code: &quot; + response.getHttpResponse().getHttpStatusCode();&#10;&#9;&#9;&#9;logger.error(&quot;error = {}&quot;, errorMessage);&#10;&#9;&#9;})&#10;&#9;&#9;.onSuccess(response -&gt; {&#10;&#9;&#9;&#9;logger.debug(response.getResponseBody());&#10;&#9;&#9;})&#10;&#9;&#9;.execute();" description="HttpRequest" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JAVA_EXPRESSION" value="true" />
    </context>
  </template>
