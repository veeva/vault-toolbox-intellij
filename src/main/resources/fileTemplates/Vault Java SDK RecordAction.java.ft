#set( $name =  ${Name} + "Action")
#set( $javaName =  "")
#foreach( $str in $name.split("-") )
	#set( $str = $str.substring(0,1).toUpperCase() + $str.substring(1) )
	#set( $javaName = $javaName + $str )
#end

/*
 * --------------------------------------------------------------------
 * RecordAction:			$javaName
 * Object:					${Object}
 * Author:					${USER}
 * Date:					${YEAR}-${MONTH}-${DAY}
 *---------------------------------------------------------------------
 * Description:	${Description}
 *---------------------------------------------------------------------
 */

import com.veeva.vault.sdk.api.action.*;

@RecordActionInfo(object="${Object}",
		label="${Label}",
		usages = Usage.UNSPECIFIED)
public class $javaName implements RecordAction {

	public boolean isExecutable(RecordActionContext context) {
		return true;
	}

	public void execute(RecordActionContext context) {

	}
}